# Create .env.local beside this file and add your Web3Forms access key there.
# Do not add NEXT_PUBLIC_ to this variable or commit your real key.
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Public Safari Digital portal connection. Leave the form key empty to skip
# portal delivery while keeping the existing Web3Forms email delivery active.
NEXT_PUBLIC_PORTAL_URL=https://your-safari-digital-portal.example
NEXT_PUBLIC_PORTAL_FORM_KEY=your-portal-form-key

# Optional public WhatsApp settings. The site defaults to the confirmed
# WhatsApp number (+255 692 796 412) and a general trip-planning message.
NEXT_PUBLIC_WHATSAPP_NUMBER=255692796412
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello Betheli Expeditions, I would like help planning a Tanzania trip.

# Public Sanity connection settings used by the Next.js frontend.
NEXT_PUBLIC_SANITY_PROJECT_ID=ife51h63
NEXT_PUBLIC_SANITY_DATASET=production
