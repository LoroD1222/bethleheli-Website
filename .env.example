# Create .env.local beside this file and add your Web3Forms access key there.
# Configure its recipient as info@betheliexpeditions.com in Web3Forms and ask Web3Forms
# to approve every production domain before publishing. This value reaches the browser because
# Web3Forms requires browser-side submissions; it is an access key, not an email credential.
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Server-only Meta Conversions API settings. Never prefix the access token with
# NEXT_PUBLIC_ or commit its real value. The pixel ID is not secret.
META_PIXEL_ID=1445827243777951
META_CONVERSIONS_API_ACCESS_TOKEN=your-meta-conversions-api-access-token

# Public Safari Digital portal connection. These values are visible in the
# browser by design and send website enquiries into the Betheli portal.
NEXT_PUBLIC_PORTAL_URL=https://safari-digital-portal.vercel.app
NEXT_PUBLIC_PORTAL_FORM_KEY=sdf_oFw6oahp09bJbfeelcJ10za7

# Optional public WhatsApp settings. The site defaults to the confirmed
# WhatsApp number (+255 692 796 412) and a general trip-planning message.
NEXT_PUBLIC_WHATSAPP_NUMBER=255692796412
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello Betheli Expeditions, I would like help planning a Tanzania trip.

# Public Sanity connection settings used by the Next.js frontend.
NEXT_PUBLIC_SANITY_PROJECT_ID=ife51h63
NEXT_PUBLIC_SANITY_DATASET=production
